# GitNanny configuration.
# Copy to .env — never commit .env itself (gitnanny would nag about it).

# API key for the AI deep review. With the hackathon gateway a dummy works.
GITNANNY_API_KEY=dummy-key

# Anthropic-compatible endpoint. Omit to use api.anthropic.com directly.
GITNANNY_BASE_URL=http://100.64.0.5:2280

# Model for the deep review (default: claude-sonnet-4-5).
GITNANNY_MODEL=glm-5.3-flash
